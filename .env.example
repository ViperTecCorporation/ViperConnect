#############################################
# Unoapi Cloud — .env example (EN/PT-BR)
# Copy this file to .env and adjust values.
# Duplicated keys are intentional defaults; comments explain usage.
#############################################

# Core server / Servidor
# HTTP port (default 9876) / Porta HTTP (padrão 9876)
# PORT=9876
# Public base URL for media links / URL pública base para links de mídia
# BASE_URL=http://localhost:9876
# Limite decodificado para mídia enviada como Base64 (bytes). Padrão: 33554432.
# UNOAPI_MEDIA_BASE64_MAX_BYTES=33554432
# Limite do JSON somente nas rotas messages/marketing_messages. Padrão: 48mb.
# UNOAPI_MESSAGES_JSON_LIMIT=48mb

# Webhook auth (optional) / Autenticação de Webhook (opcional)
# WEBHOOK_URL=http://localhost:3000/webhooks/whatsapp
# WEBHOOK_TOKEN=change-me
# WEBHOOK_HEADER=api_access_token
# Optional internal VoIP service / Serviço interno de VoIP (opcional)
# VOIP_SERVICE_URL=http://localhost:3097
# VOIP_SERVICE_TOKEN=change-me
# VOIP_SERVICE_TIMEOUT_MS=3000
# Optional explicit WebSocket URL. When omitted it is derived from VOIP_SERVICE_URL.
# VOIP_BRIDGE_URL=ws://localhost:3097/v1/bridge/zapo
# Maximum simultaneous Zapo calls owned by one session.
# VOIP_MAX_CONCURRENT_CALLS=2
IGNORE_GROUP_MESSAGES=true
IGNORE_BROADCAST_STATUSES=true

STORAGE_BUCKET_NAME=unoapi
STORAGE_ACCESS_KEY_ID=my-minio
STORAGE_SECRET_ACCESS_KEY=change-me
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_FORCE_PATH_STYLE=true

MINIO_SERVER_URL=http://localhost:9000
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
MINIO_SITE_REGION=$STORAGE_REGION
MINIO_ROOT_USER=$STORAGE_ACCESS_KEY_ID
MINIO_ROOT_PASSWORD=$STORAGE_SECRET_ACCESS_KEY
UNOAPI_AUTH_TOKEN=change-me

REJECT_CALLS=Oi, não consigo atender ligações no whatsapp, poderia me mandar uma mensagem?
REJECT_CALLS_WEBHOOK=Eu estava te ligando no whatsapp...
SEND_CONNECTION_STATUS=true

# Session / Conexão
# CONNECTION_TYPE=qrcode|pairing_code (default qrcode)
# Use pairing_code para pareamento sem exibir QR (headless)
# CONNECTION_TYPE=qrcode
# Idioma padrão das mensagens internas: pt_BR, pt ou en.
# DEFAULT_LOCALE=pt_BR
# WEBHOOK_INCLUDE_MEDIA_DATA=false
# WEBHOOK_ASYNC=false
# WEBHOOK_ASYNC_MODE=amqp
# CONTACT_SYNC_ENABLED=true
# CONTACT_SYNC_INTERVAL_MS=28800000
# CONTACT_SYNC_SCAN_COUNT=500
# CONTACT_SYNC_PENDING_TTL_SEC=900
# CONTACT_SYNC_PENDING_POLL_MS=60000

# Audio PTT behavior & conversion
# Flag outgoing audio messages as PTT (voice note)
# Recommended: true
SEND_AUDIO_MESSAGE_AS_PTT=true

# Convert PTT audio to OGG/Opus using ffmpeg
# Recommended: true
CONVERT_AUDIO_MESSAGE_TO_OGG=true

# ffmpeg parameters for conversion (JSON array)
CONVERT_AUDIO_FFMPEG_PARAMS=["-vn","-ar","48000","-ac","1","-c:a","libopus","-b:a","64k","-application","voip","-avoid_negative_ts","make_zero","-map_metadata","-1","-f","ogg"]

# Generate waveform array for outgoing PTT audio
SEND_AUDIO_WAVEFORM=true
# Number of waveform samples (resolution)
AUDIO_WAVEFORM_SAMPLES=85

# Timeout controls (ms)
WEBHOOK_TIMEOUT_MS=360000
CONSUMER_TIMEOUT_MS=450000
FETCH_TIMEOUT_MS=360000

# (Legacy) Only if you prefer using the older toggle style
# Defaults to SEND_AUDIO_MESSAGE_AS_PTT when unset

# History synchronization window
# Enable history import in your runtime config (if applicable) and
# limit import to only messages newer than N days
# IGNORE_HISTORY_MESSAGES=false
HISTORY_MAX_AGE_DAYS=30

# Group receipt/status fan-out controls
# Suppress per-participant receipts for group messages (read/played/delivered by user)
GROUP_IGNORE_INDIVIDUAL_RECEIPTS=true
# For messages.update in groups, forward only DELIVERY_ACK (delivered)
GROUP_ONLY_DELIVERED_STATUS=true

# Status/Broadcast behavior / Comportamento de Status
# Allow LID JIDs in recipients (default true). Set false to normalize to PN
# Permitir JIDs LID na lista (padrão true). Coloque false para normalizar PN
# STATUS_ALLOW_LID=true

# SOCKS proxy shared by Baileys and by Zapo WebSocket, media CDN and link preview.
# PROXY_URL=socks5://user:pass@proxy.local:1080

# Zapo outbound IP-family policy. Blank channel values inherit the global
# value. auto preserves Node dual-stack behavior; ipv6first/ipv4first only set
# preference and always keep the other family as fallback.
ZAPO_NETWORK_IP_FAMILY=auto
# ZAPO_CHAT_SOCKET_IP_FAMILY=
# ZAPO_MEDIA_UPLOAD_IP_FAMILY=
# ZAPO_MEDIA_DOWNLOAD_IP_FAMILY=
# ZAPO_LINK_PREVIEW_IP_FAMILY=

# Runtime state / Estado de runtime
# Obrigatorio: sessoes, configuracoes, IDs, leases e caches sempre usam Redis/Valkey.
REDIS_URL=redis://localhost:6379
# Default engine for sessions that do not persist a provider yet.
WHATSAPP_ENGINE=zapo
# Worker engine. Baileys runtime is suppressed in this release.
UNOAPI_WORKER_ENGINE=zapo
# Cloud entrypoint role: web, broker or worker. When omitted, starts all roles.
# Cache local (ms) para sessao/auth; 0 = somente invalidacao por pub/sub
# AUTH_CACHE_TTL_MS=30000
# SESSION_STATUS_CACHE_TTL_MS=30000
# CONNECT_COUNT_CACHE_TTL_MS=30000
# TTL (ms) para cache local de config por sessao; 0 desabilita TTL
# CONFIG_CACHE_TTL_MS=0
# AMQP_URL=amqp://guest:guest@localhost:5672?frameMax=8192
STATUS_RECIPIENT_RETENTION_SEC=2592000
CONTACT_INFO_TTL_SEC=2592000
ZAPO_REDIS_MESSAGES_TTL_MS=2592000000
ZAPO_REDIS_THREADS_TTL_MS=2592000000
ZAPO_REDIS_CONTACTS_TTL_MS=2592000000
ZAPO_REDIS_KEY_PREFIX=unoapi-zapo:
ZAPO_REDIS_MAINTENANCE_INTERVAL_MS=3600000
ZAPO_SESSION_LEASE_TTL_MS=60000
ZAPO_SESSION_LEASE_RENEW_MS=20000
