# Copie para /etc/vipertec-ddns/cloudflare.env, restrinja para 0600 e preencha localmente.
# Nunca versionar o token real.
CLOUDFLARE_API_TOKEN=SUBSTITUA_PELO_TOKEN
CLOUDFLARE_ZONE_ID=SUBSTITUA_PELO_ZONE_ID

IPV6_INTERFACE=eth0
PRIMARY_PROVIDER=starlink
STARLINK_PREFIX_HINT=2803::/16
CONECTA_PREFIX_HINT=2804::/16
IPV6_PREFERRED_ROUTE_METRIC=90

CF_RECORD_MAIN=sip6.vipertec.net
CF_RECORD_DUAL=sip.vipertec.net
CF_RECORD_RUSTDESK=ftp.vipertec.net
CF_RECORD_WIREGUARD=wg.vipertec.net
CF_RECORD_STARLINK=sip6-starlink.vipertec.net
CF_RECORD_CONECTA=sip6-conecta.vipertec.net

VOIP_COMPOSE_PATH=/var/snap/docker/common/var-lib-docker/volumes/portainer_data/_data/compose/21/docker-compose.yml
