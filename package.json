{
  "name": "viperconnect",
  "version": "4.0.31",
  "description": "ViperConnect by ViperTec Corporation, based on the original Unoapi Cloud project",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ViperTecCorporation/ViperConnect.git"
  },
  "author": "ViperTec Corporation <suporte@vipertec.com.br>",
  "contributors": [
    "Rodrigo Caitano <caitano28@gmail.com>",
    "Clairton Rodrigo <original Unoapi Cloud project author>"
  ],
  "homepage": "https://github.com/ViperTecCorporation/ViperConnect#readme",
  "bugs": {
    "url": "https://github.com/ViperTecCorporation/ViperConnect/issues"
  },
  "license": "GPL-3.0",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "lint": "eslint src",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 node_modules/jest/bin/jest.js --coverage",
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.frontend.json && node ./scripts/version-frontend-assets.cjs && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -p tsconfig.runtime.json && node ./scripts/check-zapo-runtime-graph.mjs",
    "build:all": "node ./node_modules/typescript/bin/tsc -p tsconfig.frontend.json && node ./scripts/version-frontend-assets.cjs && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -p .",
    "build:frontend": "node ./node_modules/typescript/bin/tsc -p tsconfig.frontend.json && node ./scripts/version-frontend-assets.cjs",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "dev": "NODE_OPTIONS=--max-old-space-size=4096 ./node_modules/nodemon/bin/nodemon.js src/index.ts --trace-deprecation",
    "web-dev": "NODE_OPTIONS=--max-old-space-size=4096 ./node_modules/nodemon/bin/nodemon.js src/web.ts",
    "waker-dev": "NODE_OPTIONS=--max-old-space-size=4096 ./node_modules/nodemon/bin/nodemon.js src/waker.ts",
    "worker-dev": "NODE_OPTIONS=--max-old-space-size=4096 ./node_modules/nodemon/bin/nodemon.js src/worker.ts",
    "bulker-dev": "NODE_OPTIONS=--max-old-space-size=4096 ./node_modules/nodemon/bin/nodemon.js src/bulker.ts",
    "broker-dev": "NODE_OPTIONS=--max-old-space-size=4096 ./node_modules/nodemon/bin/nodemon.js src/broker.ts",
    "bridge-dev": "NODE_OPTIONS=--max-old-space-size=4096 ./node_modules/nodemon/bin/nodemon.js src/bridge.ts",
    "cloud-dev": "NODE_OPTIONS=--max-old-space-size=4096 ./node_modules/nodemon/bin/nodemon.js src/cloud.ts",
    "start": "node --max-old-space-size=4096 dist/src/cloud.js",
    "cloud": "node --max-old-space-size=1024 dist/src/cloud.js",
    "cloud-ts": "node --max-old-space-size=4096 --experimental-strip-types --experimental-transform-types src/cloud.ts",
    "waker": "node --max-old-space-size=4096 dist/src/waker.js",
    "waker-ts": "node --max-old-space-size=4096 --experimental-strip-types --experimental-transform-types src/waker.ts",
    "web-ts": "node --max-old-space-size=4096 --experimental-strip-types --experimental-transform-types src/web.ts",
    "worker-ts": "node --max-old-space-size=4096 --experimental-strip-types --experimental-transform-types src/worker.ts",
    "bulker": "node --max-old-space-size=4096 dist/src/bulker.js",
    "bulker-ts": "node --max-old-space-size=4096 --experimental-strip-types --experimental-transform-types src/bulker.ts",
    "broker-ts": "node --max-old-space-size=4096 --experimental-strip-types --experimental-transform-types src/broker.ts",
    "bridge-ts": "node --max-old-space-size=4096 --experimental-strip-types --experimental-transform-types src/bridge.ts",
    "clean:data": "rm -rf ./data/medias/* ./data/sessions/* ./data/stores/*.json",
    "build:docs": "node ./scripts/openapi-to-json.mjs && node ./scripts/openapi-to-postman.mjs",
    "check:baileys-lock": "node ./scripts/check-baileys-lock.mjs",
    "postinstall": "node ./scripts/patch-zapo-payment-info.cjs"
  },
  "devDependencies": {
    "@whiskeysockets/baileys": "git+https://github.com/ViperTecCorporation/Baileys.git#Main",
    "@eslint/js": "^9.1.1",
    "@types/express": "^4.17.21",
    "@types/i18n": "^0.13.12",
    "@types/jest": "^29.5.12",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.12.7",
    "@types/node-fetch": "2",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@types/vcf": "^2.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^8.6.0",
    "jest": "^29.7.0",
    "jest-fetch-mock": "^3.0.3",
    "jest-mock-extended": "^3.0.6",
    "nodemon": "^3.1.0",
    "pino-pretty": "^7.0.0",
    "prettier": "^3.2.5",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.8.0"
  },
  "dependencies": {
    "@adiwajshing/keyed-db": "^0.2.4",
    "@aws-sdk/client-s3": "3.1095.0",
    "@aws-sdk/lib-storage": "3.1095.0",
    "@aws-sdk/s3-request-presigner": "3.1095.0",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@redis/client": "^1.5.14",
    "@sentry/node": "^10.68.0",
    "@zapo-js/store-redis": "1.3.0",
    "@zapo-js/store-sqlite": "1.2.0",
    "@vipertec/zapo-voip": "file:vendor/zapo-voip",
    "agent-base": "^7.1.2",
    "@zapo-js/media-utils": "1.0.0",
    "amqplib": "^0.10.8",
    "audio-decode": "^2.2.3",
    "audio2textjs": "^1.0.5",
    "awesome-phonenumber": "^6.8.0",
    "axios": "^1.18.1",
    "better-sqlite3": "12.6.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "file-type": "21.3.4",
    "i18n": "^0.15.1",
    "ioredis": "5.11.1",
    "libmlow-wasm": "0.1.1",
    "jschardet": "^3.1.2",
    "mime-types": "^2.1.35",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "openai": "^5.13.1",
    "pino": "^7.0.0",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "socks-proxy-agent": "^8.0.3",
    "undici": "^6.27.0",
    "uuid": "^11.1.1",
    "vcf": "^2.1.2",
    "ws": "^8.21.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "^2.8.3",
    "zapo-js": "1.8.2"
  },
  "engines": {
    "node": ">= 24.x"
  },
  "resolutions": {
    "@whiskeysockets/baileys": "git+https://github.com/ViperTecCorporation/Baileys.git#Main",
    "@grpc/grpc-js": "^1.14.4",
    "@babel/core": "^7.29.6",
    "@messageformat/runtime": "^3.0.2",
    "ajv": "^6.14.0",
    "body-parser": "^1.20.6",
    "diff": "^4.0.4",
    "engine.io": "^6.6.9",
    "fast-xml-parser": "^5.10.1",
    "flatted": "^3.4.3",
    "form-data": "^4.0.6",
    "handlebars": "^4.7.9",
    "ip-address": "^10.2.0",
    "jws": "^4.0.1",
    "eslint/**/js-yaml": "4.3.0",
    "eslint/**/minimatch": "3.1.4",
    "jest/**/js-yaml": "3.15.0",
    "jest/**/minimatch": "3.1.4",
    "@jest/**/js-yaml": "3.15.0",
    "@jest/**/minimatch": "3.1.4",
    "babel-plugin-istanbul/**/js-yaml": "3.15.0",
    "glob/**/minimatch": "3.1.4",
    "nodemon/**/minimatch": "3.1.4",
    "@sentry/node/**/minimatch": "9.0.7",
    "@typescript-eslint/**/minimatch": "9.0.7",
    "typescript-eslint/**/minimatch": "9.0.7",
    "rimraf/**/minimatch": "9.0.7",
    "path-to-regexp": "0.1.13",
    "picomatch": "^2.3.2",
    "protobufjs": "^7.6.5",
    "qs": "^6.15.3",
    "socket.io-parser": "^4.2.7",
    "ws": "^8.21.1"
  }
}
